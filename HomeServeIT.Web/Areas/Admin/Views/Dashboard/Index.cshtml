@model HomeServeIT.Web.Areas.Admin.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Overview";
}

<div class="content-stretch flex flex-col items-start max-w-7xl p-4 sm:p-6 lg:p-8 relative shrink-0 w-full mx-auto">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between w-full">
        <div class="content-stretch flex flex-col items-start relative shrink-0">
            <h1 class="font-['Inter'] font-[650] leading-[42px] relative shrink-0 text-[#17191c] text-[28px] whitespace-nowrap">
                Overview
            </h1>
            <p class="font-['Inter'] font-normal leading-[21px] mt-1 relative shrink-0 text-[#5d6470] text-[14px]">
                @DateTime.Now.ToString("dddd, MMM d, yyyy") &middot; @Model.PeriodDescription
            </p>
        </div>

        <form method="get" class="flex max-w-full flex-wrap items-center gap-3" aria-label="Choose overview period">
            <label for="dashboard-period" class="text-[13px] font-semibold text-[#5d6470]">Overview period</label>
            <select id="dashboard-period" name="period" class="ui-select !w-[170px] max-w-full text-[13px]" onchange="this.form.submit()">
                <option value="week" selected="@(Model.Period == "week" ? "selected" : null)">This week</option>
                <option value="month" selected="@(Model.Period == "month" ? "selected" : null)">This month</option>
                <option value="year" selected="@(Model.Period == "year" ? "selected" : null)">This year</option>
            </select>
            <button type="submit" class="sr-only">Apply period</button>
        </form>
    </div>
    
    <!-- Top Row -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 w-full mt-8">
        <!-- Card 1 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Active requests</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#17191c] text-[30px]">@Model.TotalActiveRequests</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">Pending / scheduled / in progress</p>
            </div>
        </div>
        
        <!-- Card 2 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Jobs today</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#17191c] text-[30px]">@Model.JobsTodayCount</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">Scheduled for today</p>
            </div>
        </div>
        
        <!-- Card 3 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Technicians</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#178a4b] text-[30px]">@Model.TotalTechnicians</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">@Model.AvailableTechniciansCount available now</p>
            </div>
        </div>
        
        <!-- Card 4 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Outstanding invoices</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#a96500] text-[30px]">@Model.OutstandingInvoicesAmount.ToString("C0", new System.Globalization.CultureInfo("en-PH"))</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">@Model.OutstandingInvoicesCount unpaid or overdue</p>
            </div>
        </div>
    </div>
    
    <!-- Second Row -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 w-full mt-6">
        <!-- Card 1 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Total revenue</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#0878f9] text-[30px]">@Model.TotalRevenue.ToString("C0", new System.Globalization.CultureInfo("en-PH"))</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">Paid @Model.PeriodLabel.ToLowerInvariant()</p>
            </div>
        </div>
        
        <!-- Card 2 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Low-stock items</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#d13b3b] text-[30px]">@Model.LowStockItemsCount</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">Needs reorder</p>
            </div>
        </div>
        
        <!-- Card 3 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">New customers</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#17191c] text-[30px]">@Model.NewCustomersThisWeekCount</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">Joined @Model.PeriodLabel.ToLowerInvariant()</p>
            </div>
        </div>
        
        <!-- Card 4 -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex min-h-[128px] flex-col items-start p-[20px] rounded-[16px] shadow-sm hover:shadow-md transition-shadow">
            <p class="font-['Inter'] font-[550] leading-[19.5px] text-[#5d6470] text-[13px]">Completed jobs</p>
            <div class="mt-auto flex w-full flex-col items-end text-right">
                <p class="font-['Inter'] font-[650] leading-[30px] tabular-nums text-[#178a4b] text-[30px]">@Model.CompletedJobsThisMonthCount</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px] mt-1">@Model.PeriodLabel</p>
            </div>
        </div>
    </div>
    
    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 w-full mt-6 h-auto lg:h-[280px]">
        
        <!-- Monthly Revenue Chart -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col p-[20px] rounded-[16px] shadow-sm lg:col-span-2 relative min-h-[200px]">
            <div class="flex items-center justify-between w-full mb-4">
                <p class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">@Model.RevenueChartTitle</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px]">@Model.ChartRangeLabel</p>
            </div>
            
            <div class="flex-1 w-full h-[200px] relative">
                <canvas id="revenueChart"></canvas>
                <p id="revenueChartMessage" class="hidden absolute inset-0 items-center justify-center px-4 text-center text-[13px] text-[#69717d]" role="status" aria-live="polite"></p>
            </div>
        </div>
        
        <!-- Job Status Distribution -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col p-[20px] rounded-[16px] shadow-sm">
            <p class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">Job status distribution</p>
            
            <div class="flex flex-wrap items-center justify-center gap-4 lg:gap-6 flex-1 mt-4">
                <!-- Donut Chart Canvas with Center Text -->
                <div class="relative w-[120px] h-[120px]">
                    <canvas id="statusDonutChart"></canvas>
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                        <span class="text-[20px] font-bold text-[#17191c]">@Model.TotalJobsCount</span>
                        <span class="text-[10px] text-[#69717d]">Total</span>
                    </div>
                </div>
                
                <!-- Legend -->
                <div class="flex flex-col gap-1.5 text-[12px] font-['Inter']">
                    <div class="flex items-center justify-between w-[120px]">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#178a4b]"></span>
                            <span class="text-[#5d6470]">Completed</span>
                        </div>
                        <span class="font-semibold">@Model.CompletedCount</span>
                    </div>
                    <div class="flex items-center justify-between w-[120px]">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#0878f9]"></span>
                            <span class="text-[#5d6470]">In Progress</span>
                        </div>
                        <span class="font-semibold">@Model.InProgressCount</span>
                    </div>
                    <div class="flex items-center justify-between w-[120px]">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#00bcd4]"></span>
                            <span class="text-[#5d6470]">Scheduled</span>
                        </div>
                        <span class="font-semibold">@Model.ScheduledCount</span>
                    </div>
                    <div class="flex items-center justify-between w-[120px]">
                        <div class="flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-[#f59e0b]"></span>
                            <span class="text-[#5d6470]">Pending</span>
                        </div>
                        <span class="font-semibold">@Model.PendingCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Bottom Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 w-full mt-6 h-auto lg:h-[280px]">
        
        <!-- Request Volume Chart -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col p-[20px] rounded-[16px] shadow-sm relative min-h-[200px]">
            <div class="flex items-center justify-between w-full mb-4">
                <p class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">Request volume</p>
                <p class="font-['Inter'] font-normal leading-[18px] text-[#69717d] text-[12px]">@Model.ChartRangeLabel</p>
            </div>
            
            <div class="flex-1 w-full h-[200px] relative">
                <canvas id="requestChart"></canvas>
                <p id="requestChartMessage" class="hidden absolute inset-0 items-center justify-center px-4 text-center text-[13px] text-[#69717d]" role="status" aria-live="polite"></p>
            </div>
        </div>
        
        <!-- Recent Activity -->
        <div class="bg-white border border-[#e7eaf0] border-solid flex flex-col p-[20px] rounded-[16px] shadow-sm">
            <p class="font-['Inter'] font-semibold leading-[21px] text-[#17191c] text-[14px]">Recent activity</p>
            
            <div class="flex flex-col mt-4">
                @foreach (var request in Model.RecentRequests)
                {
                    var activityStatus = request.Status;
                    var activityStatusClass = "bg-yellow-50 text-yellow-700";
                    var activityStatusDotClass = "bg-yellow-500";
                    if (request.Status == "PendingAdminApproval")
                    {
                        activityStatus = "Pending";
                    }
                    else if (request.Status == "PendingCustomerReview")
                    {
                        activityStatus = "Awaiting Customer Approval";
                    }
                    if (request.Status == "Completed")
                    {
                        activityStatusClass = "bg-green-50 text-green-700";
                        activityStatusDotClass = "bg-green-500";
                    }
                    else if (request.Status == "In Progress")
                    {
                        activityStatusClass = "bg-blue-50 text-blue-700";
                        activityStatusDotClass = "bg-blue-600";
                    }
                    else if (request.Status == "Pending" && request.TechID != null)
                    {
                        activityStatus = "Scheduled";
                    }
                    else if (request.Status == "Pending" && request.TechID == null)
                    {
                        activityStatus = "Unassigned";
                        activityStatusClass = "bg-gray-100 text-gray-700";
                        activityStatusDotClass = "bg-gray-400";
                    }
                    <div class="flex flex-col gap-2 border-b border-[#e7eaf0] py-3 last:border-0 sm:flex-row sm:items-center sm:justify-between">
                        <div class="flex min-w-0 items-start gap-3 sm:items-center">
                            <svg aria-hidden="true" class="mt-0.5 shrink-0 text-[#69717d] sm:mt-0" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                            <p class="min-w-0 font-['Inter'] text-[13px] leading-[19px] text-[#5d6470]">Request #@request.RequestID for @request.Customer?.FirstName @request.Customer?.LastName</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 pl-7 sm:shrink-0 sm:justify-end sm:pl-0">
                            <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-semibold @activityStatusClass">
                                <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full @activityStatusDotClass"></span>
                                @activityStatus
                            </span>
                            <time class="shrink-0 font-['Inter'] text-[12px] text-[#69717d]">@request.ScheduledDate.ToString("MMM dd")</time>
                        </div>
                    </div>
                }
                @if (!Model.RecentRequests.Any())
                {
                    <p class="font-['Inter'] text-[13px] text-[#5d6470] py-4">No recent activity.</p>
                }
            </div>
            
            <div class="mt-4 flex w-full flex-wrap gap-2">
                <button onclick="window.location.href='@Url.Action("Customers", "Crm", new { area = "Admin" })'" class="min-h-[44px] min-w-[120px] flex-1 rounded-lg border border-[#e7eaf0] bg-white px-3 py-2 text-[13px] font-semibold text-[#334155] transition-colors hover:border-[#bfd7f5] hover:bg-[#f5f9ff] hover:text-[#086cda] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0878f9] focus-visible:ring-offset-2">Add customer</button>
                <button onclick="window.location.href='@Url.Action("ServiceRequests", "Operations", new { area = "Admin" })'" class="min-h-[44px] min-w-[120px] flex-1 rounded-lg border border-[#0878f9] bg-[#0878f9] px-3 py-2 text-[13px] font-semibold text-white transition-colors hover:border-[#0668db] hover:bg-[#0668db] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0878f9] focus-visible:ring-offset-2">New request</button>
                <button onclick="window.location.href='@Url.Action("ServiceRequests", "Operations", new { area = "Admin" })'" class="min-h-[44px] min-w-[120px] flex-1 rounded-lg border border-[#e7eaf0] bg-white px-3 py-2 text-[13px] font-semibold text-[#334155] transition-colors hover:border-[#bfd7f5] hover:bg-[#f5f9ff] hover:text-[#086cda] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0878f9] focus-visible:ring-offset-2">Assign tech</button>
                <button onclick="window.location.href='@Url.Action("Quotations", "Finance", new { area = "Admin" })'" class="min-h-[44px] min-w-[120px] flex-1 rounded-lg border border-[#e7eaf0] bg-white px-3 py-2 text-[13px] font-semibold text-[#334155] transition-colors hover:border-[#bfd7f5] hover:bg-[#f5f9ff] hover:text-[#086cda] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0878f9] focus-visible:ring-offset-2">Create quote</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            try {
                const response = await fetch('@Url.Action("GetChartData", "Dashboard", new { area = "Admin", period = Model.Period })');
                const data = await response.json();

                const showChartMessage = (chartId, messageId, message) => {
                    document.getElementById(chartId).classList.add('hidden');
                    const messageElement = document.getElementById(messageId);
                    messageElement.textContent = message;
                    messageElement.classList.remove('hidden');
                    messageElement.classList.add('flex');
                };

                if (data.revenueData.some(value => Number(value) > 0)) {
                    new Chart(document.getElementById('revenueChart'), {
                        type: 'bar',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: 'Revenue (₱)',
                                data: data.revenueData,
                                backgroundColor: '#0878f9',
                                borderRadius: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { beginAtZero: true, grid: { display: true, color: '#f1f5f9' }, border: { display: false } },
                                x: { grid: { display: false }, border: { display: false } }
                            }
                        }
                    });
                } else {
                    showChartMessage('revenueChart', 'revenueChartMessage', 'No revenue recorded for this period.');
                }

                if (data.requestData.some(value => Number(value) > 0)) {
                    new Chart(document.getElementById('requestChart'), {
                        type: 'line',
                        data: {
                            labels: data.labels,
                            datasets: [{
                                label: 'Requests',
                                data: data.requestData,
                                borderColor: '#00bcd4',
                                backgroundColor: 'rgba(0, 188, 212, 0.1)',
                                borderWidth: 2,
                                fill: true,
                                tension: 0.4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: {
                                y: { beginAtZero: true, grid: { display: true, color: '#f1f5f9' }, border: { display: false }, ticks: { stepSize: 1 } },
                                x: { grid: { display: false }, border: { display: false } }
                            }
                        }
                    });
                } else {
                    showChartMessage('requestChart', 'requestChartMessage', 'No requests recorded for this period.');
                }

                // Status Donut Chart
                const totalJobs = @Model.TotalJobsCount;
                const donutData = totalJobs > 0 
                    ? [@Model.CompletedCount, @Model.InProgressCount, @Model.ScheduledCount, @Model.PendingCount]
                    : [0, 0, 0, 0];
                const donutBg = totalJobs > 0
                    ? ['#178a4b', '#0878f9', '#00bcd4', '#f59e0b']
                    : ['#e7eaf0', '#e7eaf0', '#e7eaf0', '#e7eaf0'];

                new Chart(document.getElementById('statusDonutChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Completed', 'In Progress', 'Scheduled', 'Pending'],
                        datasets: [{
                            data: totalJobs > 0 ? donutData : [1],
                            backgroundColor: totalJobs > 0 ? donutBg : ['#e7eaf0'],
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: { display: false },
                            tooltip: { enabled: totalJobs > 0 }
                        }
                    }
                });
            } catch (err) {
                console.error("Error loading chart data", err);
                const chartErrorMessage = "Chart data couldn't be loaded. Refresh the page to try again.";
                for (const [chartId, messageId] of [['revenueChart', 'revenueChartMessage'], ['requestChart', 'requestChartMessage']]) {
                    const chart = document.getElementById(chartId);
                    const message = document.getElementById(messageId);
                    if (chart && message) {
                        chart.classList.add('hidden');
                        message.textContent = chartErrorMessage;
                        message.classList.remove('hidden');
                        message.classList.add('flex');
                    }
                }
            }
        });
    </script>
}
