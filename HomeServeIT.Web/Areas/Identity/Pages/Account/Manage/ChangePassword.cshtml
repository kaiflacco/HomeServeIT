@page
@model HomeServeIT.Web.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@using HomeServeIT.Web.Constants
@{
    ViewData["Title"] = "Change password";
    var area = User.IsInRole(Roles.Administrator) ? "Admin" : User.IsInRole(Roles.Technician) ? "Technician" : "Customer";
    Layout = $"/Areas/{area}/Views/Shared/_{area}Layout.cshtml";
    var backUrl = area == "Admin" ? Url.Action("Settings", "System", new { area }) : Url.Action("Index", "ProfileAndSettings", new { area });
}
<div class="account-page account-password-page">
    <a href="@backUrl" class="account-back"><span aria-hidden="true">←</span> Back to settings</a>
    <header class="account-heading">
        <p class="account-eyebrow">ACCOUNT SECURITY</p>
        <h1>Change password</h1>
        <p>Choose a unique password to keep your account protected.</p>
    </header>
    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="account-status" role="status">@Model.StatusMessage</div>
    }
    <div class="account-grid">
        <form method="post" class="account-card">
            <div class="account-card-heading"><h2>Update your password</h2><p>Enter your current password to confirm it’s you.</p></div>
            <div class="account-card-body account-password-fields">
                <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>
                <div class="account-field">
                    <label asp-for="Input.OldPassword">Current password</label>
                    <input asp-for="Input.OldPassword" autocomplete="current-password" required />
                    <span asp-validation-for="Input.OldPassword"></span>
                </div>
                <div class="account-field">
                    <label asp-for="Input.NewPassword">New password</label>
                    <input asp-for="Input.NewPassword" autocomplete="new-password" aria-describedby="password-guidance" required />
                    <span asp-validation-for="Input.NewPassword"></span>
                </div>
                <div class="account-field">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
                    <span asp-validation-for="Input.ConfirmPassword"></span>
                </div>
            </div>
            <div class="account-actions account-actions-end">
                <a href="@backUrl" class="account-button account-button-secondary">Cancel</a>
                <button type="submit" class="account-button account-button-primary">Update password</button>
            </div>
        </form>
        <aside class="account-sidebar">
            <section class="account-card account-completeness">
                <div class="account-card-body" id="password-guidance">
                    <span class="account-icon" aria-hidden="true">✓</span>
                    <h2>A stronger password</h2>
                    <p>Your new password must include:</p>
                    <ul class="account-tips"><li>At least 8 characters</li><li>Uppercase and lowercase letters</li><li>At least one number</li><li>At least one special character</li></ul>
                    <p>Use a password you don’t use for another account.</p>
                </div>
            </section>
        </aside>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
